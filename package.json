{
  "name": "erp-comercial",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-api-smoke.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:local": "node scripts/seed-local-business-data.mjs",
    "db:local:start": "powershell -ExecutionPolicy Bypass -File scripts/db-local-start.ps1",
    "db:local:setup": "powershell -ExecutionPolicy Bypass -File scripts/db-local-setup.ps1",
    "fiscal:check-updates": "powershell -ExecutionPolicy Bypass -File scripts/check-fiscal-updates.ps1"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "fflate": "^0.8.2",
    "jspdf": "^4.2.1",
    "libxml2-wasm": "^0.7.1",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.11",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "xml-crypto": "^6.1.2",
    "zod": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
